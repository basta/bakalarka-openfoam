    bool sendRequest(const std::string& request) {

        if (auto err = send(sock, request.c_str(), request.length(), 0) < 0) {
            std::cerr << "Send failed bcs of error: " << err << std::endl;
            return false;
        }

        std::cout << "Request sent: " << request << std::endl;
        return true;
    }

    std::vector<int> receiveIntArray() {
        std::vector<int> result;


        int arraySize = 0;
        if (recv(sock, &arraySize, sizeof(int), 0) <= 0) {
            std::cerr << "Failed to receive array size" << std::endl;
            return result;
        }

        std::cout << "Array size: " << arraySize << std::endl;


        result.resize(arraySize);


        int totalBytesReceived = 0;
        int bytesRemaining = arraySize * sizeof(int);
        char* buffer = reinterpret_cast<char*>(result.data());

        while (bytesRemaining > 0) {
            int bytesReceived = recv(sock, buffer + totalBytesReceived, bytesRemaining, 0);

            if (bytesReceived <= 0) {
                std::cerr << "Error receiving array data" << std::endl;
                result.clear();
                return result;
            }

            totalBytesReceived += bytesReceived;
            bytesRemaining -= bytesReceived;
        }

        std::cout << "Received " << arraySize << " integers" << std::endl;
        return result;
    }
};

std::unique_ptr<SocketClient> sock_client;

int init() {
    try {

        SocketClient client("127.0.0.1", 8080);
        sock_client = std::make_unique<SocketClient>(client);


        if (!client.connect()) {
            return 1;
        }

    } catch (const std::exception& e) {
        std::cerr << "Exception: " << e.what() << std::endl;
        return 1;
    }
    return 0;
}

std::vector<std::array<int, 3>> request_field(int t) {
    if (!sock_client) {

        init();
    }


    if (!sock_client->sendRequest("REQUEST_ARRAY")) {
        Warning << "Failed to send request" << endl;
        return {};
    }
    std::vector<int> dataArray = sock_client->receiveIntArray();
    std::vector<std::array<int, 3>> result;
    for (size_t i = 0; i < dataArray.size(); i += 3) {
        result.push_back({dataArray[i], dataArray[i + 1], dataArray[i + 2]});
    }
    return result;
}

int example() {
    try {

        SocketClient client("127.0.0.1", 8080);


        if (!client.connect()) {
            return 1;
        }


        if (!client.sendRequest("REQUEST_ARRAY")) {
            return 1;
        }


        std::vector<int> dataArray = client.receiveIntArray();


        std::cout << "Received array data:" << std::endl;
        for (size_t i = 0; i < dataArray.size(); i++) {
            std::cout << dataArray[i] << " ";
            if ((i + 1) % 10 == 0) std::cout << std::endl;
        }
        std::cout << std::endl;

    } catch (const std::exception& e) {
        std::cerr << "Exception: " << e.what() << std::endl;
        return 1;
    }

    return 0;
}
