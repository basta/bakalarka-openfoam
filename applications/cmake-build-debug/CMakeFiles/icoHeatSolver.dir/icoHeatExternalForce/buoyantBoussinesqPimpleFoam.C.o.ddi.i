template<class T, class T2, class UnaryOperation>
Foam::List<T> Foam::ListOps::create
(
    const UList<T2>& input,
    const UnaryOperation& op
)
{
    const label len = input.size();

    List<T> output(len);



    const T2* in = input.begin();
    T* out = output.begin();

    for (label i = 0; i < len; ++i)
    {
        out[i] = op(in[i]);
    }

    return output;
