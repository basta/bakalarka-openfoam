(
    const tensor& rotTensor,
    const UList<T>& field
)
{
    const label loopLen = field.size();

    List<T> result(loopLen);


    for (label i = 0; i < loopLen; ++i)
    {
        result[i] = transform(rotTensor, field[i]);
    }

    return result;
