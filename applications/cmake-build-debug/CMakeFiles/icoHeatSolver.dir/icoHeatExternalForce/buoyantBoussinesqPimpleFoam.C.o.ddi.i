template<class T, class Predicate>
inline bool Foam::argList::readCheck
(
    const word& optName,
    T& val,
    const Predicate& pred,
    bool mandatory
) const
{
    if (readIfPresent<T>(optName, val))
    {
        if (!pred(val))
        {
            raiseBadInput(optName);
        }

        return true;
    }
    else if (mandatory)
    {
        FatalError(executable())
            << "Option -" << optName << " not specified" << nl
            << exit(FatalError);
    }

    return false;
}


