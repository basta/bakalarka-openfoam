template<template<class> class Field, class Cmpt>
void Foam::zip
(
    FieldField<Field, SphericalTensor<Cmpt>>& result,
    const FieldField<Field, Cmpt>& ii
)
{
    for (Foam::label i=0; i<(result).size(); ++i)
    {
        Foam::zip(result[i], ii[i]);
    }
}


