template<class Form, class Type>
void Foam::multiply
(
    Matrix<Form, Type>& ans,
    const Matrix<Form, Type>& A,
    const Matrix<Form, Type>& B
)
{
    if (A.n() != B.m())
    {
        ::Foam::FatalError((__PRETTY_FUNCTION__), "/usr/lib/openfoam/openfoam2406/src/OpenFOAM/lnInclude/scalarMatricesTemplates.C", 247)
            << "A and B must have identical inner dimensions but A.n = "
            << A.n() << " and B.m = " << B.m()
            << abort(FatalError);
    }

    ans = Matrix<Form, Type>(A.m(), B.n(), Zero);

    for (label i = 0; i < A.m(); ++i)
    {
        for (label j = 0; j < B.n(); ++j)
        {
            for (label l = 0; l < B.m(); ++l)
            {
                ans(i, j) += A(i, l)*B(l, j);
            }
        }
    }
}
