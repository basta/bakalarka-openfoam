template<class Cmpt>
inline Foam::Tensor<Cmpt> Foam::Tensor<Cmpt>::adjunct2D
(
    const direction excludeCmpt
) const
{
    switch (excludeCmpt)
    {
        case 0:
        {
            return Tensor<Cmpt>
            (
                Zero, Zero, Zero,
                Zero, zz(), -yz(),
                Zero, -zy(), yy()
            );
        }

        case 1:
        {
            return Tensor<Cmpt>
            (
                zz(), Zero, -xz(),
                Zero, Zero, Zero,
               -zx(), Zero, xx()
            );
        }
    }


    return Tensor<Cmpt>
    (
        yy(), -xy(), Zero,
       -yx(), xx(), Zero,
        Zero, Zero, Zero
    );
}


template<class Cmpt>
inline Foam::Tensor<Cmpt> Foam::Tensor<Cmpt>::inv2D
(
    const direction excludeCmpt
) const
{
    const Cmpt detval = this->det2D(excludeCmpt);

    return this->adjunct2D(excludeCmpt)/detval;
}


