(
    const FieldField<fvPatchField, Type>& fvpff
)
{
    auto tresult = tmp<FieldField<fvsPatchField, Type>>::New(fvpff.size());
    auto& result = tresult.ref();

    for (Foam::label patchi=0; patchi<(result).size(); ++patchi)
