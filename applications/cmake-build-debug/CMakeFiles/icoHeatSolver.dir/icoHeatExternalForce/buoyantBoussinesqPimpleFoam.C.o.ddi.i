Foam::PrimitivePatch<FaceList, PointField>::findEdge
(
    const edge& e
) const
{
    if (e.good() && e.first() < nPoints() && e.second() < nPoints())
    {

        const edgeList& myEdges = this->edges();

        for (const label patchEdgei : pointEdges()[e.first()])
        {
            if (e == myEdges[patchEdgei])
            {
                return patchEdgei;
            }
        }
    }

    return -1;
}
