template<class T, class InputIterator, class UnaryOperation>
Foam::List<T> Foam::ListOps::create
(
    InputIterator first,
    InputIterator last,
    const UnaryOperation& op
)
{
    const label len = std::distance(first, last);

    List<T> output(len);



    T* out = output.begin();

    while (first != last)
    {
        *out = op(*first);
        ++first;
        ++out;
    }

    return output;
}


