Foam::MRFZoneList::zeroFilter
(
    const tmp<GeometricField<Type, fvsPatchField, surfaceMesh>>& tphi
) const
{
    if (size())
    {
        tmp<surfaceScalarField> zphi
        (
            New
            (
                tphi,
                "zeroFilter(" + tphi().name() + ')',
                tphi().dimensions(),
                true
            )
        );

        for (Foam::label i=0; i<(*this).size(); ++i)
        {
