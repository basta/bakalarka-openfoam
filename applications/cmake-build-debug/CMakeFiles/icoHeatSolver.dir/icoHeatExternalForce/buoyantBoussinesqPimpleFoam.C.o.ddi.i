                    (
                        newFacesPatch,
                        -1
                    );
                    facePatchFaceMap_[meshNrbId][nbrId].setSize
                    (
                        newFacesPatch,
                        -1
                    );
                    faceBoundMap_[meshNrbId][nbrId].setSize
                    (
                        newFacesPatch,
                        -1
                    );
