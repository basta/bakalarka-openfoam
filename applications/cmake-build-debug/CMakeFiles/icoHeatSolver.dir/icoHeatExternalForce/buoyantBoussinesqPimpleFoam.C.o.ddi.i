                for (Foam::label i=0; i<(pFacesVisited).size(); ++i)
                {
                    if (!pFacesVisited[i])
                    {
                        Info<< "    " << pFaces[i] << endl;
                    }
                }
            }
        }
    }

    return foundError;
}
