template<class Type, template<class> class PatchField, class GeoMesh>
template<class CheckPatchFieldType>
bool Foam::GeometricBoundaryField<Type, PatchField, GeoMesh>::checkConsistency
(
    const scalar tol,
    const bool doExit
) const
{
    if (!this->size())
    {
        return true;
    }

    if (debug&2)
    {
        const auto& pfld0 = this->operator[](0);
        ::Foam::Pout << (__PRETTY_FUNCTION__) << ':'
            << " Checking boundary consistency for field "
            << pfld0.internalField().name()
            << endl;
    }

    auto& bfld = const_cast<GeometricBoundaryField<Type, PatchField, GeoMesh>&>
    (
        *this
    );



    List<Field<Type>> oldBfld(this->size());
    boolList oldUpdated(this->size());



    for (auto& pfld : bfld)
    {
        if (isA<CheckPatchFieldType>(pfld))
        {
            const label patchi = pfld.patch().index();
            oldUpdated[patchi] = pfld.updated();
            oldBfld[patchi] = pfld;

        }
    }



    {
        const label startOfRequests = UPstream::nRequests();

        for (auto& pfld : bfld)
        {
            if (isA<CheckPatchFieldType>(pfld))
            {
                pfld.initEvaluate(UPstream::commsTypes::nonBlocking);
            }
        }


        UPstream::waitRequests(startOfRequests);

        for (auto& pfld : bfld)
        {
            if (isA<CheckPatchFieldType>(pfld))
            {
                pfld.evaluate(UPstream::commsTypes::nonBlocking);
            }
        }
    }



    bool ok = true;
    for (auto& pfld : bfld)
    {
        if (isA<CheckPatchFieldType>(pfld))
        {
            const label patchi = pfld.patch().index();
            const auto& oldPfld = oldBfld[patchi];

            for (Foam::label facei=0; facei<(pfld).size(); ++facei)
            {
                if (mag(pfld[facei]-oldPfld[facei]) > tol)
                {
                    ok = false;
                    break;
                }
            }

            if (!ok)
            {
                if (doExit)
                {
                    ::Foam::FatalError((__PRETTY_FUNCTION__), "/usr/lib/openfoam/openfoam2406/src/OpenFOAM/lnInclude/GeometricBoundaryField.C", 129) << "Field "
                        << pfld.internalField().name()
                        << " is not evaluated?"
                        << " On patch " << pfld.patch().name()
                        << " type " << pfld.type()
                        << " : average of field = "
                        << average(oldPfld)
                        << ". Average of evaluated field = "
                        << average(pfld)
                        << ". Difference:" << average(pfld-oldPfld)
                        << ". Tolerance:" << tol
                        << exit(FatalError);
                }
                else
                {
                    ::Foam::Warning((__PRETTY_FUNCTION__), "/usr/lib/openfoam/openfoam2406/src/OpenFOAM/lnInclude/GeometricBoundaryField.C", 144) << "Field "
                        << pfld.internalField().name()
                        << " is not evaluated?"
                        << " On patch " << pfld.patch().name()
                        << " type " << pfld.type()
                        << " : average of field = "
                        << average(oldPfld)
                        << ". Average of evaluated field = "
                        << average(pfld)
                        << ". Difference:" << average(pfld-oldPfld)
                        << ". Tolerance:" << tol
                        << endl;


                    break;
                }
            }
        }
    }


    for (auto& pfld : bfld)
    {
        if (isA<CheckPatchFieldType>(pfld))
        {
            const label patchi = pfld.patch().index();
            pfld.setUpdated(oldUpdated[patchi]);
