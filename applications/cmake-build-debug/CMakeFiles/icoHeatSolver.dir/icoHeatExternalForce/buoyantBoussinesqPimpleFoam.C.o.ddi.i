template<class Type>
void Foam::dimensioned<Type>::writeEntry
(
    const word& keyword,
    Ostream& os
) const
{
    if (keyword.size())
    {
        os.writeKeyword(keyword);

        if (keyword != name_)
        {

            os << name_ << token::SPACE;
        }
    }
    else
    {

        os.writeKeyword(name_);
    }


    scalar mult{1};
    dimensions_.write(os, mult);


    os << token::SPACE << value_/mult;
    os.endEntry();

    os.check(__PRETTY_FUNCTION__);
}




