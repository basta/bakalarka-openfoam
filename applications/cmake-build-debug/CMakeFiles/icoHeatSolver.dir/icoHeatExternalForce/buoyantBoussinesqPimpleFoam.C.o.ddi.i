template<class Type>
void clamp
(
    Field<Type>& result,
    const UList<Type>& f1,
    const MinMax<Type>& range
)
{


    if (result.cdata() == f1.cdata())
    {

        result.clamp_range(range);
    }
    else
    {
        std::transform
        (
            f1.cbegin(),
            f1.cbegin(result.size()),
            result.begin(),
            clampOp<Type>(range)
        );
    }
}

