void Foam::unzip
(
    const FieldField<Field, SphericalTensor<Cmpt>>& input,
    FieldField<Field, Cmpt>& ii
)
{
    for (Foam::label i=0; i<(input).size(); ++i)
    {
        Foam::unzip(input[i], ii[i]);
    }
}




