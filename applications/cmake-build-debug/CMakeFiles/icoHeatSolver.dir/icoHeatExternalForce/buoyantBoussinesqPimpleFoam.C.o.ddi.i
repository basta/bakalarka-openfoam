template<class Type>
const Type* Foam::ITstream::findCompound(label pos) const
{
    if (pos < 0)
    {
        pos = tokenIndex_;
    }

    const Type* ptr = nullptr;

    for (; pos < tokenList::size(); ++pos)
    {
        ptr = tokenList::operator[](pos).isCompound<Type>();

        if (ptr)
        {
            break;
        }
    }

    return ptr;
}
