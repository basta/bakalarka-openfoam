struct reuseTmpGeometricField
{

    static tmp<GeometricField<TypeR, PatchField, GeoMesh>> New
    (
        const GeometricField<Type1, PatchField, GeoMesh>& f1,
        const word& name,
        const dimensionSet& dimensions
    )
