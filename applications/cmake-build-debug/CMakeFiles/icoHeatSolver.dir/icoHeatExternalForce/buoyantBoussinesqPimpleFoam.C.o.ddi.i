    if
    (
        f.size()
     && UPstream::floatTransfer
     && (!std::is_integral<Type>::value && sizeof(scalar) != sizeof(float))
    )
    {
        static const label nCmpts =
        (

            std::is_integral<Type>::value
          ? 1
