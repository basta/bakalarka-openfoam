template<class T, class BaseType>
bool Foam::CompactIOList<T, BaseType>::overflows() const
{
    const List<T>& lists = *this;

    label total = 0;
    for (const auto& sublist : lists)
    {
        const label prev = total;
        total += sublist.size();
        if (total < prev)
        {
            return true;
        }
    }
    return false;
}




