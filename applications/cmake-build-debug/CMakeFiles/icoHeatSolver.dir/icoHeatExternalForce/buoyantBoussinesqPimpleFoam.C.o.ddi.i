    for (const Foam::face& f : oldFaces)
    {
        Foam::face& newF = newFaces[newFacei];
        newF.resize(f.size());

        label newFp = 0;
        label prevVerti = -1;

        for (const label verti : f)
        {
            if (verti != prevVerti)
            {
                newF[newFp++] = verti;
                prevVerti = verti;
            }
        }

        if ((newFp > 1) && (newF[newFp-1] == newF[0]))
        {
            --newFp;
        }

        if (newFp > 2)
        {

            newF.resize(newFp);
            ++newFacei;
        }
    }
    newFaces.resize(newFacei);

