    const DimensionedField<scalar, GeoMesh>& dsf,
    const dimensionedScalar& ds
)
{
    auto tres =
        DimensionedField<scalar, GeoMesh>::New
        (
            "atan2(" + dsf.name() + ',' + ds.name() + ')',
