    return value;
}


template<class Type>
Type Foam::Random::globalPosition(const Type& start, const Type& end)
{
    Type value(Zero);

    if (Pstream::master())
    {
        value = position<Type>(start, end);
    }

    Pstream::broadcast(value);

    return value;
}


template<class Type>
