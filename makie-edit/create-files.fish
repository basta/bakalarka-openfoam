#!/usr/bin/fish

# Create the root directory and navigate into it
mkdir makie-plot-editor
cd makie-plot-editor

# Create frontend structure
mkdir -p frontend/css frontend/js frontend/assets/icons
touch frontend/index.html
touch frontend/css/style.css
touch frontend/js/app.js
touch frontend/js/ui.js
touch frontend/js/websocket_client.js
touch frontend/js/plot_display.js
# You can add placeholder icon files if needed, e.g.:
# touch frontend/assets/icons/placeholder.svg

# Create backend structure
mkdir -p backend/src backend/plots_output
touch backend/src/MakiePlotEditor.jl
touch backend/src/server.jl
touch backend/src/plot_manager.jl
touch backend/src/attribute_handler.jl
touch backend/src/export_handler.jl
touch backend/src/utils.jl
touch backend/Project.toml
touch backend/Manifest.toml # Usually generated by Pkg, but good to have a placeholder
touch backend/run_server.jl

# Create config structure
mkdir -p config
touch config/app_settings.json

# Create root files
touch .gitignore
touch README.md

# Print a success message and list the structure
echo "Project structure 'makie-plot-editor' created successfully."
tree -L 3 # Assumes 'tree' command is installed. Use 'ls -R' for a basic recursive listing if not.

cd .. # Go back to the parent directory
