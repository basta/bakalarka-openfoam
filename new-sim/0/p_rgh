FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // WALLS
    fixedWallTop
    {
        type zeroGradient;
    }
    
    fixedWallBottom
    {
        type fixedValue;
        value uniform 0; // Anchors p_rgh at 0 (gauge pressure)
    }

    // INLET
    coldEnd
    {
        type zeroGradient;
    }

    // OUTLET (Reference pressure patch)
    hotEnd
    {
        type zeroGradient;
    }
}


