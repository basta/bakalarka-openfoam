// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     icoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1e+11;

deltaT          0.002;

writeControl    runTime;

writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

// --- Socket Communication Settings ---
serverIP        "127.0.0.1";      // IP address of the external program (e.g., Julia)
serverPort      8080;           // Port the external program is listening on
controlInterval 1;            // Time interval (in simulation seconds) between communications
// -----------------------------------

wallHeatFluxPatches (hotBlockInterface coldBlockInterface);

runTimeModifiable yes; // Allows changing controlDict parameters while running

// --- Time step controls ---
adjustTimeStep  yes;        // Enable automatic adjustment
maxCo           0.7;        // Target maximum Courant number
maxDeltaT       0.1;        // Absolute maximum allowable time step
// --- End Time step controls ---

solidProperties
{
    hotBlock
    {
        mass    1.0;      // kg (or calculate from rho*volume)
        Cp      500;      // J/(kg*K) Specific heat capacity
        initialTemp 373.15; // K (Initial temperature)
    }
    coldBlock
    {
        mass    1.0;      // kg
        Cp      500;      // J/(kg*K)
        initialTemp 273.15; // K
    }
}

writeCellCentres
{
    type            writeCellCentres;
    libs            ( fieldFunctionObjects );
}

functions
{
    // --- Function object to calculate gradient of Temperature (T) ---
    // gradientT // This is a user-chosen name for this specific task
    // {
    //     type            gradient; // Specifies the 'gradient' function object
    //     libs            ("libfieldFunctionObjects.so"); // Library containing this function object

    //     field           T;        // Input field: Calculate gradient of T
    //     result          gradT;    // Output field name: Result will be saved as 'gradT'
    //                               // (You can choose another name like 'gradient(T)')

    //     // gradientScheme  Gauss linear;
    // }
    hotEndHeatFlux
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        writeControl    writeTime; // Or timeStep, etc.
        log             yes;       // Log average/integral to screen/log file
        valueOutput     yes;       // Write the field values to time directories

        patches         (hotBlockInterface);  // Specify your patch name
    }
    // coldEndHeatFlux
    // {
    //     type            wallHeatFlux;
    //     libs            (fieldFunctionObjects);
    //     writeControl    writeTime; // Or timeStep, etc.
    //     log             yes;       // Log average/integral to screen/log file
    //     valueOutput     yes;       // Write the field values to time directories

    //     patches         (coldEnd);  // Specify your patch name
    // }


}


